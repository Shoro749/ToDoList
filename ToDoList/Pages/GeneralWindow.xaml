<Window x:Class="ToDoList.Pages.GeneralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoList.Pages"
        mc:Ignorable="d"
        Title="GeneralWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
            Background="#388E3C"  
            Padding="5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                       Text="JUST DO LIST"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

                <Button Grid.Column="1" 
                    Content="Add new list"
                    HorizontalAlignment="Left"
                    Margin="15,0,0,0"
                    Background="#4CAF50"
                    Foreground="White"
                    Height="30" Click="CreateNewList">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#388E3C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBox Grid.Column="4"
                     Width="150"
                     Height="30"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Log out"
                        Margin="0,0,5,0"
                        Background="#D32F2F"
                        Foreground="White"
                        Height="30" Click="LogOutClick"/>
                    <Button Content="Delete users"
                        Margin="0,0,10,0"
                        Background="#D32F2F"
                        Foreground="White"
                        Height="30" Click="DeleteUserClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                Background="#2D2D30" 
                Padding="10">
                <StackPanel x:Name="sp_lists">

                    <!--<TextBlock Text="Jobs" 
                           Foreground="#AAAAAA" 
                           FontSize="16" 
                           Margin="0,10,0,0"/>
                <Separator Background="#444444" Margin="0,5,0,10"/>

                <TextBlock Text="Products" 
                           Foreground="#AAAAAA" 
                           FontSize="16"/>
                <Separator Background="#444444" Margin="0,5,0,10"/>-->

                </StackPanel>
            </Border>

            <Border Grid.Column="1" 
                Background="#1E1E1E" 
                Padding="20">

                <TextBlock Text="Ласкаво просимо! Ваші завдання тут." 
                       Foreground="#999999" 
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Grid>
</Window>
